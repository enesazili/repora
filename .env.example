# Repora Environment Configuration

# GitHub OAuth Credentials
# Register a GitHub OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encryption key for GitHub access tokens (64 random hex characters / 32 bytes)
REPORA_TOKEN_ENCRYPTION_KEY=

# Server-side SQLite database defaults to data/repora.db.
# Production requires a persistent writable disk and one server instance.
